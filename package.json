{
  "name": "app-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI copilot overlay for any desktop application",
  "main": "prebuild/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "cd src/renderer && yarn install",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "yarn run build:main && concurrently -k \"yarn run dev:renderer\" \"yarn run dev:electron\"",
    "prebuild": "electron-builder install-app-deps",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "yarn run build:renderer && yarn run build:main",
    "postbuild": "node scripts/move-native.js",
    "release": "electron-builder --publish=never",
    "lint": "cd src/renderer && yarn run lint",
    "prepare": "husky"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "node-gyp-build": "^4.8.4",
    "throttle-debounce": "^5.0.2"
  },
  "build": {
    "appId": "com.app.copilot",
    "productName": "AppCopilot",
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "prebuild/main/**/*",
      "prebuild/renderer/**/*",
      "prebuild/native/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/throttle-debounce": "^5.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "node-gyp": "^12.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.10"
  },
  "gypfile": true
}
